# Netlify redirect / access rules
#
# The publish directory IS the repository root (netlify.toml: publish = "."),
# so repository-only files would otherwise be readable over HTTP. They are not
# part of the website and must not be served.
#
# /content/site.json is deliberately NOT blocked: main.js fetches it at runtime
# for the header and footer. /admin/* is not blocked either - that is the CMS.

# Repository documentation (this is the file that described a different business)
/readme.md         /404-not-found  404
/README.md         /404-not-found  404

# The build toolchain: generator, templates, notes
/build/*           /404-not-found  404

# Git internals
/.git/*            /404-not-found  404
/.gitattributes    /404-not-found  404
/.gitignore        /404-not-found  404

# Content source that only the build needs (site.json stays reachable)
/content/policies.json  /404-not-found  404
